# ========================================================
# Налаштування автоматизації TeamSpeak 6 + Portwarp
# ========================================================

# [ВАРІАНТ 1: ПОВНА АВТОМАТИЗАЦІЯ БЕЗ БРАУЗЕРА]
# Вкажіть ваші облікові дані від акаунта portwarp.com:
PORTWARP_EMAIL=
PORTWARP_PASSWORD=

# Назва тунелю у вашому кабінеті Portwarp (якщо не вказано, вибереться перший активний тунель):
PORTWARP_TUNNEL_NAME="TeamSpeak 3"

# Публічна адреса тунелю (необов'язково, скрипт визначить автоматично):
PORTWARP_PUBLIC_ADDRESS=your-subdomain.free.tryportwarp.cc:12345

# ========================================================
# Налаштування сервера TeamSpeak 6
# ========================================================
TSSERVER_DEFAULT_PORT=9987
TSSERVER_FILE_TRANSFER_PORT=30033
TSSERVER_QUERY_HTTP_PORT=10080
